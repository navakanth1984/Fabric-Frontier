# NthDimension Academy — Atlas Publisher Environment
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── GitHub PAT ───────────────────────────────────────────────────────────────
# Get from: github.com → Settings → Developer settings →
#           Personal access tokens → Tokens (classic)
# Scope: repo  |  Recommended expiry: 1 year (fine-grained PAT)
# Fine-grained PAT: only needs "Contents: Read & Write" on Fabric-Frontier repo
# Classic PAT: repo scope is fine
ATLAS_GITHUB_TOKEN=ghp_your_token_here

# ── Optional overrides (defaults match current setup) ────────────────────────
# ATLAS_GITHUB_OWNER=navakanth1984
# ATLAS_GITHUB_REPO=Fabric-Frontier
# ATLAS_GITHUB_BRANCH=main
# ATLAS_BASE_URL=https://nthdimensionacademy.com
